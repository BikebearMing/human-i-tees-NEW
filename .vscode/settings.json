{
  // Treat Liquid files as HTML for Emmet so abbreviations like
  // ".preloader" + Tab expand to <div class="preloader"></div>.
  "emmet.includeLanguages": {
    "liquid": "html"
  },
  // Make sure .liquid files are always detected as the Liquid language.
  "files.associations": {
    "*.liquid": "liquid"
  }
}
