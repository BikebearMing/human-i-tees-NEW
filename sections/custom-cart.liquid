{%- comment -%}
  Cart page (/cart) — the fallback for the bag drawer (snippets/cart-drawer.liquid),
  styled to match it: line items on the left (image, title, options, qty,
  remove, line price), the total + checkout on the right, split by a rule.
  Then a "Keep shopping" strip in the Our Tees grid (first three tees of the
  shop collection, or of all products).

  Plain form, no Dawn cart JS: qty changes submit the form (POST /cart with
  updates[]), Remove is the line's url_to_remove, Checkout posts `checkout`.
  Shell styles are shared with the other utility pages
  (assets/section-utility-page.css).
{%- endcomment -%}

{{ 'section-utility-page.css' | asset_url | stylesheet_tag }}
{{ 'section-our-tees.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign shop_collection = collections.all
  if collections['shop'].products_count > 0
    assign shop_collection = collections['shop']
  endif
-%}

{%- style -%}
  #ccart-{{ section.id }} .ccart__body {
    display: grid;
    grid-template-columns: 2fr 1fr;
    border-bottom: 1px solid var(--util-line);
  }

  /* ---- items ---- */
  #ccart-{{ section.id }} .ccart__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  #ccart-{{ section.id }} .ccart__item {
    display: grid;
    grid-template-columns: max(84px, 8.333vw) 1fr auto;
    column-gap: max(14px, 1.389vw);
    align-items: start;
    padding: var(--util-pad);
  }
  #ccart-{{ section.id }} .ccart__item + .ccart__item {
    border-top: 1px solid var(--util-line);
  }
  #ccart-{{ section.id }} .ccart__media {
    display: block;
    aspect-ratio: 1 / 1;
    background: var(--beige);
  }
  #ccart-{{ section.id }} .ccart__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  #ccart-{{ section.id }} .ccart__info {
    display: flex;
    flex-direction: column;
    gap: max(6px, 0.417vw);
    min-width: 0;
  }
  #ccart-{{ section.id }} .ccart__name {
    color: var(--black);
    text-decoration: none;
  }
  #ccart-{{ section.id }} .ccart__meta {
    color: var(--util-muted);
    text-transform: uppercase;
  }
  #ccart-{{ section.id }} .ccart__controls {
    display: flex;
    align-items: center;
    gap: max(14px, 0.972vw);
    margin-top: max(8px, 0.556vw);
  }
  /* Qty pill — same shape as the bag drawer's. */
  #ccart-{{ section.id }} .ccart__qty {
    display: inline-flex;
    align-items: center;
    height: max(30px, 2.083vw);
    border: 1px solid var(--black);
    border-radius: 999px;
    overflow: hidden;
  }
  #ccart-{{ section.id }} .ccart__qty button,
  #ccart-{{ section.id }} .ccart__qty input {
    height: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--black);
    text-align: center;
  }
  #ccart-{{ section.id }} .ccart__qty button {
    width: max(28px, 1.944vw);
    cursor: pointer;
  }
  #ccart-{{ section.id }} .ccart__qty input {
    width: max(28px, 2vw);
    -moz-appearance: textfield;
    appearance: textfield;
  }
  #ccart-{{ section.id }} .ccart__qty input::-webkit-outer-spin-button,
  #ccart-{{ section.id }} .ccart__qty input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  #ccart-{{ section.id }} .ccart__remove {
    color: #c9bcae;
    text-transform: uppercase;
    text-underline-offset: 2px;
    transition: color 0.3s ease;
  }
  #ccart-{{ section.id }} .ccart__remove:hover {
    color: var(--black);
  }
  #ccart-{{ section.id }} .ccart__price {
    text-align: right;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  #ccart-{{ section.id }} .ccart__price s {
    display: block;
    opacity: 0.5;
  }

  /* ---- summary ---- */
  #ccart-{{ section.id }} .ccart__summary {
    position: sticky;
    top: var(--header-height, 0px);
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: max(12px, 0.972vw);
    padding: var(--util-pad);
  }
  #ccart-{{ section.id }} .ccart__body::before {
    content: '';
    grid-column: 2;
    grid-row: 1;
    border-left: 1px solid var(--util-line);
    pointer-events: none;
  }
  #ccart-{{ section.id }} .ccart__list,
  #ccart-{{ section.id }} .ccart__summary {
    grid-row: 1;
  }
  #ccart-{{ section.id }} .ccart__summary {
    grid-column: 2;
  }
  #ccart-{{ section.id }} .ccart__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }
  #ccart-{{ section.id }} .ccart__label {
    text-transform: uppercase;
  }
  #ccart-{{ section.id }} .ccart__note {
    color: var(--util-muted);
  }
  #ccart-{{ section.id }} .ccart__discounts {
    list-style: none;
    margin: 0;
    padding: 0;
    color: var(--util-muted);
  }
  #ccart-{{ section.id }} .ccart__summary .custom-button {
    text-align: center;
    cursor: pointer;
  }

  /* ---- keep shopping strip ---- */
  #ccart-{{ section.id }} .ccart__more {
    border-bottom: 1px solid var(--util-line);
  }

  /* ---- phone + tablet: summary under the items ---- */
  @media (max-width: 1024px) {
    #ccart-{{ section.id }} .ccart__body {
      grid-template-columns: 1fr;
    }
    #ccart-{{ section.id }} .ccart__body::before {
      display: none;
    }
    #ccart-{{ section.id }} .ccart__list,
    #ccart-{{ section.id }} .ccart__summary {
      grid-row: auto;
      grid-column: 1;
    }
    #ccart-{{ section.id }} .ccart__summary {
      position: static;
      border-top: 1px solid var(--util-line);
    }
  }
{%- endstyle -%}

<div class="util ccart" id="ccart-{{ section.id }}">
  <header class="util__head">
    <p class="body util__crumb">{{ section.settings.crumb | escape }}</p>
    <h1 class="h2-v2 util__title">{{ section.settings.heading | escape }}</h1>
  </header>
  <p class="body util__band">
    {%- if cart == empty -%}
      Nothing in the bag yet
    {%- else -%}
      {{ cart.item_count }} product{% if cart.item_count != 1 %}s{% endif %}
    {%- endif -%}
  </p>

  {%- if cart == empty -%}
    <div class="util__empty">
      <h2 class="h3">{{ section.settings.empty_heading | escape }}</h2>
      <p class="body">{{ section.settings.empty_text | escape }}</p>
      <a class="custom-button" href="{{ shop_collection.url }}">
        <span class="button-span body">SHOP NOW</span>
      </a>
    </div>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post" id="CartPage-Form-{{ section.id }}" class="ccart__body" novalidate>
      <ul class="ccart__list" role="list">
        {%- for item in cart.items -%}
          <li class="ccart__item">
            <a href="{{ item.url }}" class="ccart__media" tabindex="-1" aria-hidden="true">
              {%- if item.image -%}
                <img src="{{ item.image | image_url: width: 300 }}" alt="" loading="lazy" width="150" height="150">
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag }}
              {%- endif -%}
            </a>

            <div class="ccart__info">
              <a href="{{ item.url }}" class="h4 ccart__name">{{ item.product.title | escape }}</a>
              {%- unless item.product.has_only_default_variant -%}
                <p class="body ccart__meta">
                  {%- for option in item.options_with_values -%}
                    {{ option.value | escape }}{% unless forloop.last %} / {% endunless %}
                  {%- endfor -%}
                </p>
              {%- endunless -%}
              {%- for property in item.properties -%}
                {%- assign first_char = property.first | slice: 0 -%}
                {%- if property.last != blank and first_char != '_' -%}
                  <p class="body ccart__meta">{{ property.first | escape }}: {{ property.last | escape }}</p>
                {%- endif -%}
              {%- endfor -%}
              {%- for discount in item.line_level_discount_allocations -%}
                {%- if discount.amount > 0 -%}
                  <p class="body ccart__meta">{{ discount.discount_application.title | escape }}</p>
                {%- endif -%}
              {%- endfor -%}

              <div class="ccart__controls">
                <div class="ccart__qty" data-ccart-qty>
                  <button type="button" class="body" data-step="-1" aria-label="{{ 'products.product.quantity.decrease' | t: product: item.product.title | escape }}">&minus;</button>
                  <input
                    class="body"
                    type="number"
                    name="updates[]"
                    value="{{ item.quantity }}"
                    min="0"
                    {% if item.variant.quantity_rule.max != null %}max="{{ item.variant.quantity_rule.max }}"{% endif %}
                    aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
                  >
                  <button type="button" class="body" data-step="1" aria-label="{{ 'products.product.quantity.increase' | t: product: item.product.title | escape }}">+</button>
                </div>
                <a class="body ccart__remove" href="{{ item.url_to_remove }}">Remove</a>
              </div>
            </div>

            <p class="body ccart__price">
              {%- if item.original_line_price != item.final_line_price -%}
                <s>{{ item.original_line_price | money }}</s>
              {%- endif -%}
              {{ item.final_line_price | money }}
            </p>
          </li>
        {%- endfor -%}
      </ul>

      <aside class="ccart__summary">
        {%- comment -%} A $0.00 line is the ambassador code; the fundraiser card's green note covers it. {%- endcomment -%}
        {%- liquid
          assign shown_discounts = 0
          for discount in cart.cart_level_discount_applications
            if discount.total_allocated_amount > 0
              assign shown_discounts = shown_discounts | plus: 1
            endif
          endfor
        -%}
        {%- if shown_discounts > 0 -%}
          <ul class="body ccart__discounts" role="list">
            {%- for discount in cart.cart_level_discount_applications -%}
              {%- if discount.total_allocated_amount > 0 -%}
                <li>{{ discount.title | escape }} (-{{ discount.total_allocated_amount | money }})</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
        <div class="ccart__row">
          <span class="body ccart__label">Total</span>
          <span class="h3">{{ cart.total_price | money }}</span>
        </div>
        <p class="body ccart__note">{{ section.settings.note | escape }}</p>
        {%- render 'fundraiser-toggle', context: 'page' -%}
        <button type="submit" name="checkout" class="custom-button full-width">
          <span class="button-span body">CHECKOUT</span>
        </button>
        <a class="custom-button full-width" href="{{ shop_collection.url }}">
          <span class="button-span body">KEEP SHOPPING</span>
        </a>
      </aside>
    </form>
  {%- endif -%}

  {%- if section.settings.show_more and shop_collection.products_count > 0 -%}
    <section class="our-tees ccart__more">
      <div class="our-tees__col our-tees__heading-col">
        <h2 class="h1-v2 our-tees__heading">{{ section.settings.more_heading | escape }}</h2>
        <a class="custom-button our-tees__shop-all" href="{{ shop_collection.url }}">
          <span class="button-span body">SHOP ALL</span>
        </a>
      </div>
      {%- for product in shop_collection.products limit: 3 -%}
        {%- render 'tee-card', product: product -%}
      {%- endfor -%}
    </section>
  {%- endif -%}
</div>

<script>
  /* Qty pill: − / + step the field; any change submits the cart form, which
     updates the cart server-side and reloads the page. */
  (function () {
    var root = document.getElementById('ccart-{{ section.id }}');
    var form = root && root.querySelector('form');
    if (!form) return;
    var timer;
    function submitSoon() {
      clearTimeout(timer);
      timer = setTimeout(function () { form.submit(); }, 450);
    }
    root.querySelectorAll('[data-ccart-qty]').forEach(function (qty) {
      var input = qty.querySelector('input');
      qty.querySelectorAll('button[data-step]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var next = Math.max(0, (parseInt(input.value, 10) || 0) + parseInt(btn.dataset.step, 10));
          if (input.max) next = Math.min(next, parseInt(input.max, 10));
          input.value = next;
          submitSoon();
        });
      });
      input.addEventListener('change', submitSoon);
    });
  })();
</script>

{% schema %}
{
  "name": "Cart",
  "tag": "section",
  "class": "custom-cart-section",
  "settings": [
    {
      "type": "text",
      "id": "crumb",
      "label": "Small label",
      "default": "Cart"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your bag"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note under the total",
      "default": "Taxes and shipping calculated at checkout."
    },
    {
      "type": "header",
      "content": "Empty cart"
    },
    {
      "type": "text",
      "id": "empty_heading",
      "label": "Heading",
      "default": "It's empty :("
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Text",
      "default": "Every tee gives back to the planet. Pick one out."
    },
    {
      "type": "header",
      "content": "Keep shopping"
    },
    {
      "type": "checkbox",
      "id": "show_more",
      "label": "Show tees under the cart",
      "default": true
    },
    {
      "type": "text",
      "id": "more_heading",
      "label": "Heading",
      "default": "Our Tees"
    }
  ]
}
{% endschema %}
