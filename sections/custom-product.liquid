    },
    {
      "type": "paragraph",
      "content": "Hand-lettered label shown under the title (e.g. \"Wear What Matters\"). Paste an image URL — leave blank to hide."
    },
    {
      "type": "text",
      "id": "cursive_image",
      "label": "Cursive image URL"
    },
    {
      "type": "header",
      "content": "Description"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description (overrides product description)"
    },
    {
      "type": "header",
      "content": "Buy controls"
    },
    {
      "type": "text",
      "id": "size_label",
      "label": "Size label",
      "default": "SELECT SIZE"
    },
    {
      "type": "text",
      "id": "size_guide_label",
      "label": "Size guide link text",
      "default": "SIZE GUIDE"
    },
    {
      "type": "url",
      "id": "size_guide_url",
      "label": "Size guide URL"
    },
    {
      "type": "page",
      "id": "size_guide_page",
      "label": "Size guide page (overrides URL)"
    },
    {
      "type": "text",
      "id": "atc_label",
      "label": "Add to cart label",
      "default": "ADD TO CART"
    },
    {
      "type": "text",
