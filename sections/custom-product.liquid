        { "value": "off", "label": "Never" },
        { "value": "tag", "label": "When product is tagged \"new\"" },
        { "value": "always", "label": "Always" }
      ],
      "default": "tag"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "NEW"
