      "id": "step2_heading",
      "label": "Heading",
      "default": "Where should we send your kit?"
    },
    {
      "type": "text",
      "id": "step2_text",
      "label": "Text",
      "info": "[name] becomes \", Jordan\" (their first name from step 1).",
      "default": "Thanks[name]. A few details so we can ship it and send the right number of catalogs."
    },
    {
      "type": "text",
      "id": "step2_button",
      "label": "Button label",
