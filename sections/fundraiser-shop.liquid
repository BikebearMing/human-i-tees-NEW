{%- comment -%}
  Fundraiser shop — the landing page fundraiser share links open
  (/pages/fundraiser, template page.fundraisers). Rebuilt from the old
  theme's two Custom Liquid sections; the links the fundraising platform
  already sends keep working unchanged:

    /pages/fundraiser?first=Jon&campaign=Westfield%20Key%20Club&end=2026-12-01&img=<Supabase URL>

  - first / campaign: rewrite the eyebrow, headline, intro, points and button
    (same wording as the old page). Without either, the default copy shows.
  - end (YYYY-MM-DD): "Only N days left" on the photo, when 1-119 days remain.
  - img: replaces the photo, only from the platform's Supabase
    campaign-images bucket.
  The share link goes through /discount/CODE first, so the code is already
  on the cart (the bag shows the green "Fundraiser code applied" note).
  Either link shape works: /discount/CODE?redirect=/pages/fundraiser&first=…
  or the whole page link encoded inside redirect= (Shopify encodes that one
  twice; the script undoes it). On a theme preview, Shopify's redirect drops
  the query entirely, so test the two halves separately there.

  Left: eyebrow, headline, intro, ticked points, button down to the tees.
  Right: the campaign photo. Below: the fundraiser catalog in the shared
  tee-card grid (assets/section-our-tees.css), 4 ruled columns.
  Spacing follows sections/free-kit.liquid (1440 mock, px / 14.4 = vw).
{%- endcomment -%}

{{ 'section-our-tees.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #fsh-{{ section.id }} {
    --fsh-line: #d9cdb8; /* same rule colour as the .has-line columns (custom.css) */
    --fsh-orange: #ff944d; /* the theme's CTA orange (.custom-button) */
    --fsh-muted: rgba(51, 51, 51, 0.6); /* --black at 60% */
    --fsh-top: 1.944vw;
    --fsh-grid-line: rgba(51, 51, 51, 0.2);

    position: relative;
    width: 100%;
    color: var(--black);
  }

  /* only the centre column line; the 25/75 ones would cut through the copy */
  #fsh-{{ section.id }} .fsh__hero > .line-overlay > i:nth-child(odd) { display: none; }

  /* Carries the header clearance and rules the line under the header. */
  #fsh-{{ section.id }} .fsh__hero {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    padding-top: var(--header-height, 6rem);
  }
  #fsh-{{ section.id }} .fsh__hero::before {
    content: '';
    position: absolute;
    top: var(--header-height, 6rem);
    left: 0;
    right: 0;
    border-top: 1px solid var(--fsh-line);
  }

  /* ----- Left ----- */
  #fsh-{{ section.id }} .fsh__intro {
    position: relative;
    z-index: 1;
    padding: var(--fsh-top) 0.972vw 2.778vw;
  }
  #fsh-{{ section.id }} .fsh__title {
    padding-top: 0.486vw;
    overflow-wrap: anywhere;
  }
  #fsh-{{ section.id }} .fsh__text {
    max-width: max(280px, 24.306vw);
    padding-top: 0.903vw;
  }
  #fsh-{{ section.id }} .fsh__points {
    padding-top: 1.389vw;
  }
  /* on the wrapper: .custom-button is inline, so a margin on it is ignored */
  #fsh-{{ section.id }} .fsh__cta {
    padding-top: 1.667vw;
  }
  #fsh-{{ section.id }} .fsh__trust {
    padding-top: 0.694vw;
    color: var(--fsh-muted);
  }

  /* ----- Right: the photo, with the days-left chip on it ----- */
  #fsh-{{ section.id }} .fsh__media {
    position: relative;
    z-index: 1;
    padding: var(--fsh-top) 0.972vw 2.778vw;
  }
  #fsh-{{ section.id }} .fsh__frame {
    position: relative;
  }
  #fsh-{{ section.id }} .fsh__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: var(--beige);
  }
  #fsh-{{ section.id }} .fsh__chip {
    position: absolute;
    left: 0.972vw;
    bottom: 0.972vw;
    padding: max(6px, 0.486vw) max(12px, 0.972vw);
    border-radius: 999px;
    background: var(--fsh-orange);
    color: var(--black);
  }
  #fsh-{{ section.id }} .fsh__chip[hidden] { display: none; }

  /* ----- The tees ----- */
  #fsh-{{ section.id }} .fsh__grid {
    scroll-margin-top: var(--header-height, 0px);
    border-top: 1px solid var(--fsh-grid-line);
  }
  #fsh-{{ section.id }} .fsh__empty {
    grid-column: 1 / -1;
    padding: 4.167vw 16px;
    text-align: center;
  }

  /* ===== TABLET + MOBILE (<= 1024px): one column, then two ruled columns
     of tees (as the shop page, so 18 tees don't run one per row) ===== */
  @media (max-width: 1024px) {
    #fsh-{{ section.id }} .fsh__hero > .line-overlay { display: none; }
    #fsh-{{ section.id }} .fsh__hero { grid-template-columns: minmax(0, 1fr); }
    #fsh-{{ section.id }} .fsh__intro { padding: 24px 16px 0; }
    #fsh-{{ section.id }} .fsh__title { padding-top: 8px; }
    #fsh-{{ section.id }} .fsh__text { padding-top: 12px; }
    #fsh-{{ section.id }} .fsh__points { padding-top: 16px; }
    #fsh-{{ section.id }} .fsh__cta { padding-top: 20px; }
    #fsh-{{ section.id }} .fsh__trust { padding-top: 10px; }
    #fsh-{{ section.id }} .fsh__media { padding: 24px 16px 32px; }
    #fsh-{{ section.id }} .fsh__chip { left: 12px; bottom: 12px; }

    #fsh-{{ section.id }} .fsh__grid {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 0;
      padding: 0;
    }
    #fsh-{{ section.id }} .fsh__grid > .our-tees__col:nth-child(n) {
      border-left: 0;
      border-top: 0;
    }
    #fsh-{{ section.id }} .fsh__grid > .our-tees__col:nth-child(even) {
      border-left: 1px solid var(--fsh-grid-line);
    }
    #fsh-{{ section.id }} .fsh__grid > .our-tees__col:nth-child(n + 3) {
      border-top: 1px solid var(--fsh-grid-line);
    }
    #fsh-{{ section.id }} .fsh__grid .our-tees__card {
      height: auto;
      padding: 3vw;
    }
    #fsh-{{ section.id }} .fsh__grid .our-tees__media {
      width: 100%;
      aspect-ratio: 1 / 1; /* the tee photos are square */
    }
  }
{%- endstyle -%}

{%- liquid
  # The old page's photo, used until one is picked in the theme editor.
  assign fallback_image = 'https://humaniteesimpact.com/images/community-group.jpg'

  assign catalog = section.settings.collection
  if catalog == blank
    assign catalog = collections['our-fundraiser-catalog'] | default: collections['shop'] | default: collections.all
  endif
  assign shop_id = 'fsh-shop-' | append: section.id
-%}

<section class="fsh" id="fsh-{{ section.id }}">
  <div class="fsh__hero has-line">
    <div class="fsh__intro">
      <p class="body uppercase" data-fsh="eyebrow" data-reveal>{{ section.settings.eyebrow | escape }}</p>
      <h1 class="h1-v2 uppercase fsh__title" data-fsh="title" data-reveal>{{ section.settings.heading | escape }}</h1>
      <p class="body fsh__text" data-fsh="sub" data-reveal>{{ section.settings.text | escape }}</p>

      <ul class="check-list fsh__points" role="list">
        {%- for i in (1..3) -%}
          {%- liquid
            assign key = 'point_' | append: i
            assign point = section.settings[key]
          -%}
          {%- if point != blank -%}
            <li class="body">
              <img class="check-list__icon" src="{{ 'check.svg' | asset_url }}" width="28" height="27" alt="" loading="lazy">
              <span data-fsh="point-{{ i }}">{{ point | escape }}</span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      <div class="fsh__cta">
        <a class="custom-button" href="#{{ shop_id }}">
          <span class="button-span body uppercase" data-fsh="cta">{{ section.settings.button_label | escape }}</span>
        </a>
      </div>
      {%- if section.settings.trust != blank -%}
        <p class="body fsh__trust">{{ section.settings.trust | escape }}</p>
      {%- endif -%}
    </div>

    <div class="fsh__media">
      <div class="fsh__frame">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1600
            | image_tag:
              class: 'fsh__image',
              widths: '600, 900, 1200, 1600',
              sizes: '(min-width: 1025px) 50vw, 100vw',
              loading: 'eager',
              fetchpriority: 'high'
          }}
        {%- else -%}
          <img class="fsh__image" src="{{ fallback_image }}" alt="" width="1200" height="900" loading="eager" fetchpriority="high">
        {%- endif -%}
        <span class="fsh__chip body uppercase" data-fsh="chip" hidden></span>
      </div>
    </div>
  </div>

  <div class="our-tees fsh__grid" id="{{ shop_id }}" aria-label="{{ catalog.title | escape }}">
    {%- for product in catalog.products limit: 24 -%}
      {%- render 'tee-card', product: product, show_badge: false, heading_tag: 'h2', show_view: false -%}
    {%- else -%}
      <p class="body fsh__empty">{{ section.settings.empty_text | escape }}</p>
    {%- endfor -%}
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('fsh-{{ section.id }}');
    if (!root) return;
    try {
      // Shopify's /discount/CODE?redirect= encodes a nested link a second
      // time, so these can arrive as "Westfield%20Key%20Club" and
      // "https%3A%2F%2F…". Undo that one extra layer.
      var once = function (v) {
        try { return decodeURIComponent(v); } catch (e) { return v; }
      };
      var q = new URLSearchParams(window.location.search);
      var text = function (key) {
        var v = q.get(key) || '';
        return (/%[0-9a-f]{2}/i.test(v) ? once(v) : v).trim();
      };
      var first = text('first').slice(0, 40);
      var campaign = text('campaign').slice(0, 80);
      var img = (q.get('img') || '').trim();
      if (/^https%3a/i.test(img)) img = once(img);
      var end = text('end');

      var el = function (key) { return root.querySelector('[data-fsh="' + key + '"]'); };
      var set = function (key, text) { var e = el(key); if (e) e.textContent = text; };

      if (first || campaign) {
        set('eyebrow', campaign ? campaign + ' · Official fundraiser' : 'Official fundraiser');

        var title = first
          ? first + ' is fundraising' + (campaign ? ' for ' + campaign : '') + ' — help them win it'
          : 'Support the ' + campaign + ' fundraiser';
        set('title', title);
        // a long campaign name would run the 100px headline down the page
        if (title.length > 64) {
          var t = el('title');
          t.classList.remove('h1-v2');
          t.classList.add('h3');
        }

        var subBits = ['Every shirt you grab sends $5 straight to ' + (campaign || 'their fundraiser')];
        if (first) subBits.push('and ' + first + ' gets the credit');
        set('sub', subBits.join(' — ') + '. These are tees people actually keep wearing.');

        set('point-1', '$5 of every shirt goes to ' + (campaign || 'the fundraiser'));
        set('point-2', (first ? first + "'s" : 'Their') + ' discount is already applied at checkout');
        if (first) set('cta', 'Shop now & back ' + first);
      }

      if (end) {
        var days = Math.ceil((new Date(end + 'T23:59:59') - new Date()) / 86400000);
        if (isFinite(days) && days > 0 && days < 120) {
          var chip = el('chip');
          chip.textContent = days === 1 ? 'Final day!' : 'Only ' + days + ' days left';
          chip.hidden = false;
        }
      }

      // the campaign photo, only from the platform's bucket; back to the
      // default photo if it doesn't load
      var photo = root.querySelector('.fsh__image');
      if (photo && img && /^https:\/\/czrxgtbjwylnlywjnufp\.supabase\.co\/storage\/v1\/object\/public\/campaign-images\//.test(img)) {
        var original = { src: photo.getAttribute('src'), srcset: photo.getAttribute('srcset'), sizes: photo.getAttribute('sizes') };
        photo.onerror = function () {
          photo.onerror = null;
          if (original.srcset) photo.setAttribute('srcset', original.srcset);
          if (original.sizes) photo.setAttribute('sizes', original.sizes);
          photo.src = original.src;
        };
        photo.removeAttribute('srcset');
        photo.removeAttribute('sizes');
        photo.src = img;
      }
    } catch (e) {
      /* the page falls back to the default copy */
    }
  })();
</script>

{% schema %}
{
  "name": "Fundraiser shop",
  "class": "fundraiser-shop-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Fundraiser share links fill in the student's name, campaign, days left and photo (?first=, ?campaign=, ?end=, ?img=). The text below shows when the link has none."
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Humanitees Fundraiser" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop tees that give back" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Intro",
      "default": "Every shirt you buy sends $5 straight to a school fundraiser, and they're shirts you'll actually want to wear."
    },
    { "type": "text", "id": "point_1", "label": "Point 1", "default": "$5 of every shirt goes to the fundraiser" },
    { "type": "text", "id": "point_2", "label": "Point 2", "default": "Their discount is already applied at checkout" },
    { "type": "text", "id": "point_3", "label": "Point 3", "default": "Sustainably made, wear-it-forever quality" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the collection" },
    { "type": "text", "id": "trust", "label": "Line under the button", "default": "Discount applied automatically. Nothing to enter." },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo",
      "info": "Shown when the link has no campaign photo. Blank uses the old page's group photo."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Tees",
      "info": "Blank uses Our Fundraiser Catalog."
    },
    { "type": "text", "id": "empty_text", "label": "Text when there are no tees", "default": "The fundraiser collection is loading. Check back in a moment." }
  ]
}
{% endschema %}
