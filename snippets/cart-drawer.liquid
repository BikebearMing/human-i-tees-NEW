{% comment %}
  Bag drawer — the side checkout. Slides in from the right, under the fixed
  header, and closes on the ×, the overlay or Escape.

  The markup keeps every id/class that Dawn's cart JS looks for (assets/cart.js,
  assets/cart-drawer.js, assets/product-form.js re-render parts of this by id):
  #CartDrawer, #CartDrawer-Overlay, .drawer__inner, .drawer__inner-empty,
  cart-drawer-items, .cart-drawer__footer, .cart-item, .cart-item__name,
  #CartDrawer-Item-N, #Drawer-quantity-N, #CartDrawer-LineItemError-N,
  #CartDrawer-CartItems, #CartDrawer-CartErrors, #CartDrawer-LiveRegionText,
  #CartDrawer-LineItemStatus, #CartDrawer-Form, .loading__spinner,
  quantity-input + .quantity__button/.quantity__input, cart-remove-button.
  Everything else is bag-*. Styles live here; Dawn's component-cart-drawer.css
  is not loaded (see layout/theme.liquid).

  Usage: {% render 'cart-drawer' %} right after <body> in layout/theme.liquid.
{% endcomment %}

<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>

<style>
  cart-drawer.bag-drawer {
    --bag-pad: max(14px, 0.972vw);
    --bag-line: #d9cdb8;
    --bag-orange: #e88742;
    position: fixed;
    inset: var(--header-height, 0px) 0 0 0; /* the bar stays in view above it (mock) */
    z-index: 1000;
    display: block;
    visibility: hidden;
    transition: visibility 0.45s;
  }
  cart-drawer.bag-drawer.active {
    visibility: visible;
  }
  .bag-drawer__wrap {
    position: absolute;
    inset: 0;
  }
  /* click-to-close; no tint, the page shows through as in the mock */
  .bag-drawer .cart-drawer__overlay {
    position: absolute;
    inset: 0;
  }
  .bag-drawer .drawer__inner {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(calc(100vw - 40px), max(420px, 29.861vw));
    display: flex;
    flex-direction: column;
    background: #f9f7f3;
    border-left: 1px solid var(--bag-line);
    overflow: hidden;
    transform: translateX(100%);
    transition: transform 0.45s cubic-bezier(0.76, 0, 0.24, 1);
  }
  cart-drawer.bag-drawer.active .drawer__inner {
    transform: translateX(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .bag-drawer .drawer__inner {
      transition: none;
    }
  }

  /* ---- head: BAG / count / × ---- */
  .bag__head {
    position: relative;
    flex: 0 0 auto;
    padding: 3px var(--bag-pad) 0;
  }
  .bag__title {
    font-family: var(--futura);
    font-size: max(72px, 6.944vw);
    font-weight: 700;
    line-height: 0.8;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--black);
  }
  .bag__sub {
    margin-top: max(6px, 0.417vw) !important;
    text-transform: uppercase;
    color: var(--black);
  }
  .bag__close {
    position: absolute;
    top: max(10px, 0.694vw);
    right: var(--bag-pad);
    width: max(44px, 3.056vw);
    height: max(44px, 3.056vw);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 1px solid var(--bag-line);
    border-radius: 50%;
    background: transparent;
    color: var(--black);
    cursor: pointer;
    transition: background-color 0.3s ease, color 0.3s ease;
  }
  .bag__close:hover {
    background: var(--black);
    color: #fff;
  }
  .bag__close svg {
    width: max(12px, 0.833vw);
    height: auto;
  }

  /* ---- free shipping progress ---- */
  .bag__ship {
    flex: 0 0 auto;
    padding: max(12px, 0.833vw) var(--bag-pad) max(12px, 0.833vw);
    border-bottom: 1px solid var(--bag-line);
  }
  cart-drawer.is-empty .bag__ship {
    display: none;
  }
  .bag__ship-text {
    font-family: var(--geist);
    font-size: max(13px, 0.972vw);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--black);
  }
  .bag__ship-text strong {
    font-weight: 700;
  }
  .bag__ship-track {
    height: 4px;
    margin-top: max(8px, 0.556vw);
    border-radius: 999px;
    background: #e5ddd3;
    overflow: hidden;
  }
  .bag__ship-track i {
    display: block;
    height: 100%;
    border-radius: 999px;
    background: var(--bag-orange);
    transition: width 0.4s ease;
  }

  /* ---- items ---- */
  cart-drawer-items.bag__items {
    display: block;
    flex: 1 1 auto;
    min-height: 0;
    overflow: auto;
    scrollbar-width: thin;
    padding: max(18px, 1.25vw) var(--bag-pad) 0;
  }
  cart-drawer.is-empty .bag__items {
    display: none;
  }
  .bag-drawer .cart__items--disabled {
    pointer-events: none;
    opacity: 0.55;
  }
  .bag__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* component-cart-items.css (loaded site-wide for the cart page) also styles
     .cart-item — everything it sets is reset here. */
  .bag-drawer .cart-item {
    position: relative;
    display: grid;
    grid-template-columns: max(72px, 5vw) 1fr auto;
    grid-template-rows: auto auto;
    column-gap: max(12px, 0.833vw);
    row-gap: max(10px, 0.694vw);
    align-items: start;
    margin: 0;
    padding: max(14px, 0.972vw) 0;
    border-top: 1px solid var(--bag-line);
  }
  .bag-drawer .cart-item:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .bag-item__media-link {
    grid-row: 1 / 3;
    display: block;
  }
  .bag-item__media {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: contain;
  }
  .bag-item__info {
    min-width: 0;
  }
  .bag-drawer .cart-item__name {
    display: block;
    font-family: var(--futura);
    font-size: max(20px, 1.528vw);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--black);
    text-decoration: none;
  }
  .bag-item__meta {
    margin-top: 5px !important;
    font-family: var(--geist);
    font-size: max(13px, 0.972vw);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--black);
  }
  .bag-item__price {
    grid-column: 3;
    grid-row: 1;
    font-family: var(--geist);
    font-size: max(15px, 1.111vw);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--black);
    text-align: right;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .bag-item__price s {
    margin-right: 6px;
    font-weight: 400;
    opacity: 0.5;
  }
  .bag-item__controls {
    grid-column: 2 / 4;
    grid-row: 2;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: max(14px, 0.972vw);
  }
  .bag-qty {
    display: inline-flex;
    align-items: center;
    height: max(30px, 2.083vw);
    border: 1px solid var(--black);
    border-radius: 999px;
    overflow: hidden;
  }
  .bag-qty .quantity__button {
    width: max(28px, 1.944vw);
    height: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    background: transparent;
    font-family: var(--geist);
    font-size: max(14px, 0.972vw);
    font-weight: 600;
    line-height: 1;
    color: var(--black);
    cursor: pointer;
  }
  .bag-qty .quantity__input {
    width: max(28px, 2vw);
    height: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    text-align: center;
    font-family: var(--geist);
    font-size: max(13px, 0.903vw);
    font-weight: 600;
    color: var(--black);
    opacity: 1;
    -moz-appearance: textfield;
    appearance: textfield;
  }
  .bag-qty .quantity__input::-webkit-outer-spin-button,
  .bag-qty .quantity__input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  .bag-item__remove {
    padding: 0;
    border: 0;
    background: none;
    font-family: var(--geist);
    font-size: max(13px, 0.972vw);
    font-weight: 600;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: #c9bcae;
    text-decoration: underline;
    text-underline-offset: 2px;
    cursor: pointer;
    transition: color 0.3s ease;
  }
  .bag-item__remove:hover {
    color: var(--black);
  }
  .bag-drawer .cart-item__error {
    grid-column: 2 / 4;
    display: block;
    width: auto;
    min-width: 0;
    margin: 0;
    font-family: var(--geist);
    font-size: 12px;
    color: #c0392b;
  }
  .bag-drawer .cart-item .loading__spinner {
    position: absolute;
    top: max(14px, 0.972vw);
    right: 0;
  }
  .bag-drawer #CartDrawer-CartErrors:not(:empty) {
    padding: 8px 0;
    font-family: var(--geist);
    font-size: 12px;
    color: #c0392b;
  }

  /* ---- empty ---- */
  .bag__empty {
    display: none;
    flex: 1 1 auto;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: max(8px, 0.556vw);
    padding: var(--bag-pad);
    text-align: center;
  }
  cart-drawer.is-empty .bag__empty {
    display: flex;
  }
  .bag__empty-title {
    font-family: var(--futura);
    font-size: max(30px, 2.778vw);
    font-weight: 700;
    line-height: 0.85;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--black);
  }
  .bag__empty-link {
    font-family: var(--geist);
    font-size: max(14px, 0.972vw);
    font-weight: 600;
    letter-spacing: -0.42px;
    color: var(--black);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* ---- foot: TOTAL / checkout ---- */
  .bag__foot {
    flex: 0 0 auto;
    margin: 0 0 var(--bag-pad);
    padding: max(11px, 0.764vw) var(--bag-pad) 0;
    border-top: 1px solid var(--bag-line);
  }
  .bag__discounts {
    list-style: none;
    margin: 0 0 6px;
    padding: 0;
    font-family: var(--geist);
    font-size: 12px;
    font-weight: 600;
    color: #7a6f63;
  }
  .bag__total {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }
  .bag__total-label {
    text-transform: uppercase;
    color: var(--black);
  }
  .bag__total-value {
    font-family: var(--futura);
    font-size: max(32px, 2.5vw);
    font-weight: 700;
    line-height: 0.85;
    letter-spacing: -0.02em;
    color: var(--black);
    font-variant-numeric: tabular-nums;
  }
  .bag__checkout {
    display: block;
    width: 100%;
    height: max(50px, 3.472vw);
    margin-top: max(30px, 2.083vw);
    padding: 0;
    border: 1px solid var(--black);
    border-radius: 999px;
    background: var(--bag-orange);
    color: var(--black);
    font-family: var(--futura);
    font-size: max(24px, 1.944vw);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    cursor: pointer;
    transition: filter 0.3s ease;
  }
  .bag__checkout:hover {
    filter: brightness(1.06);
  }
  .bag__checkout[disabled] {
    cursor: not-allowed;
    filter: none;
  }
</style>

<cart-drawer class="drawer bag-drawer{% if cart == empty %} is-empty{% endif %}">
  <div id="CartDrawer" class="bag-drawer__wrap">
    <div id="CartDrawer-Overlay" class="cart-drawer__overlay"></div>
    <div
      class="drawer__inner"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'sections.cart.title' | t }}"
      tabindex="-1"
    >
      <div class="bag__head">
        <h2 class="bag__title">Bag</h2>
        <p class="bag__sub body">
          {%- if cart == empty -%}
            Nothing in the bag yet
          {%- else -%}
            {{ cart.item_count }} product{% if cart.item_count != 1 %}s{% endif %}
          {%- endif -%}
        </p>
        <button
          class="drawer__close bag__close"
          type="button"
          onclick="this.closest('cart-drawer').close()"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          {{- 'icon-close.svg' | inline_asset_content -}}
        </button>
      </div>

      {%- liquid
        assign ship_threshold = settings.cart_free_shipping_threshold | default: 0 | times: 100
      -%}
      {%- if ship_threshold > 0 -%}
        {%- liquid
          assign ship_left = ship_threshold | minus: cart.total_price
          assign ship_pct = cart.total_price | times: 100 | divided_by: ship_threshold | at_most: 100
        -%}
        <div class="bag__ship" role="status">
          <p class="bag__ship-text">
            {%- if ship_left > 0 -%}
              You&rsquo;re <strong>{{ ship_left | money }}</strong> away from free shipping.
            {%- else -%}
              You&rsquo;ve unlocked free shipping.
            {%- endif -%}
          </p>
          <div class="bag__ship-track" aria-hidden="true"><i style="width: {{ ship_pct }}%"></i></div>
        </div>
      {%- endif -%}

      <cart-drawer-items class="bag__items">
        <form action="{{ routes.cart_url }}" id="CartDrawer-Form" method="post">
          <div id="CartDrawer-CartItems">
            {%- if cart != empty -%}
              <ul class="bag__list" role="list">
                {%- for item in cart.items -%}
                  {%- assign line = item.index | plus: 1 -%}
                  <li id="CartDrawer-Item-{{ line }}" class="cart-item bag-item">
                    {%- render 'loading-spinner' -%}

                    <a href="{{ item.url }}" class="bag-item__media-link" tabindex="-1" aria-hidden="true">
                      {%- if item.image -%}
                        <img
                          class="bag-item__media"
                          src="{{ item.image | image_url: width: 240 }}"
                          alt=""
                          loading="lazy"
                          width="120"
                          height="150"
                        >
                      {%- else -%}
                        <span class="bag-item__media"></span>
                      {%- endif -%}
                    </a>

                    <div class="bag-item__info">
                      <a href="{{ item.url }}" class="cart-item__name">{{ item.product.title | escape }}</a>
                      {%- if item.product.has_only_default_variant == false -%}
                        <p class="bag-item__meta">
                          {%- for option in item.options_with_values -%}
                            {{ option.value | escape }}{% unless forloop.last %} / {% endunless %}
                          {%- endfor -%}
                        </p>
                      {%- endif -%}
                      {%- for property in item.properties -%}
                        {%- assign first_char = property.first | slice: 0 -%}
                        {%- if property.last != blank and first_char != '_' -%}
                          <p class="bag-item__meta">{{ property.first | escape }}: {{ property.last | escape }}</p>
                        {%- endif -%}
                      {%- endfor -%}
                      {%- if item.selling_plan_allocation -%}
                        <p class="bag-item__meta">{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>
                      {%- endif -%}
                      {%- for discount in item.line_level_discount_allocations -%}
                        <p class="bag-item__meta">{{ discount.discount_application.title | escape }}</p>
                      {%- endfor -%}
                    </div>

                    <div class="bag-item__price">
                      {%- if item.original_line_price != item.final_line_price -%}
                        <s>{{ item.original_line_price | money }}</s>
                      {%- endif -%}
                      {{ item.final_line_price | money }}
                    </div>

                    <div class="bag-item__controls">
                      <quantity-input class="bag-qty">
                        <button
                          class="quantity__button"
                          name="minus"
                          type="button"
                          aria-label="{{ 'products.product.quantity.decrease' | t: product: item.product.title | escape }}"
                          {% if item.instructions and item.instructions.can_update_quantity == false %}disabled{% endif %}
                        >&minus;</button>
                        <input
                          class="quantity__input"
                          type="number"
                          name="updates[]"
                          value="{{ item.quantity }}"
                          data-quantity-variant-id="{{ item.variant.id }}"
                          {% # theme-check-disable %}
                          data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}"
                          min="{{ item.variant.quantity_rule.min }}"
                          data-min="{{ item.variant.quantity_rule.min }}"
                          {% if item.variant.quantity_rule.max != null %}
                            max="{{ item.variant.quantity_rule.max }}"
                          {% endif %}
                          step="{{ item.variant.quantity_rule.increment }}"
                          {% # theme-check-enable %}
                          aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
                          id="Drawer-quantity-{{ line }}"
                          data-index="{{ line }}"
                          {% if item.instructions and item.instructions.can_update_quantity == false %}disabled{% endif %}
                        >
                        <button
                          class="quantity__button"
                          name="plus"
                          type="button"
                          aria-label="{{ 'products.product.quantity.increase' | t: product: item.product.title | escape }}"
                          {% if item.instructions and item.instructions.can_update_quantity == false %}disabled{% endif %}
                        >+</button>
                      </quantity-input>

                      <cart-remove-button id="CartDrawer-Remove-{{ line }}" data-index="{{ line }}">
                        <button
                          type="button"
                          class="bag-item__remove"
                          aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}"
                          data-variant-id="{{ item.variant.id }}"
                          {% if item.instructions and item.instructions.can_remove == false %}hidden{% endif %}
                        >
                          Remove
                        </button>
                      </cart-remove-button>
                    </div>

                    <div id="CartDrawer-LineItemError-{{ line }}" class="cart-item__error" role="alert">
                      <small class="cart-item__error-text"></small>
                    </div>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
            <p id="CartDrawer-LiveRegionText" class="visually-hidden" role="status"></p>
            <p id="CartDrawer-LineItemStatus" class="visually-hidden" aria-hidden="true" role="status">
              {{ 'accessibility.loading' | t }}
            </p>
          </div>
          <div id="CartDrawer-CartErrors" role="alert"></div>
        </form>
      </cart-drawer-items>

      <div class="drawer__inner-empty bag__empty">
        <p class="bag__empty-title">It&rsquo;s empty :(</p>
        <a href="{{ routes.all_products_collection_url }}" class="bag__empty-link">Shop now</a>
      </div>

      <div class="cart-drawer__footer bag__foot">
        {%- if cart.cart_level_discount_applications.size > 0 -%}
          <ul class="bag__discounts" role="list" aria-label="{{ 'customer.order.discount' | t }}">
            {%- for discount in cart.cart_level_discount_applications -%}
              <li>{{ discount.title | escape }} (-{{ discount.total_allocated_amount | money }})</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        <div class="bag__total" role="status">
          <span class="bag__total-label body">Total</span>
          <span class="bag__total-value">{{ cart.total_price | money }}</span>
        </div>
        <button
          type="submit"
          id="CartDrawer-Checkout"
          class="bag__checkout"
          name="checkout"
          form="CartDrawer-Form"
          {% if cart == empty %}disabled{% endif %}
        >
          Checkout
        </button>
      </div>
    </div>
  </div>
</cart-drawer>

<script>
  /* Dawn's CartItems.resetQuantityInput only knows the cart page's #Quantity-N
     ids, so a rejected quantity (typed below the minimum) threw in the drawer. */
  customElements.whenDefined('cart-drawer-items').then(function () {
    var P = customElements.get('cart-drawer-items').prototype;
    P.resetQuantityInput = function (id) {
      var input = this.querySelector('#Drawer-quantity-' + id);
      if (input) input.value = input.getAttribute('value');
      this.isEnterPressed = false;
    };
  });

  /* Lenis owns the scroll, so body overflow alone does not hold the page while
     the drawer is open. cart-drawer.js toggles .active; mirror it onto Lenis. */
  (function () {
    var el = document.querySelector('cart-drawer');
    if (!el || !('MutationObserver' in window)) return;
    var wasOpen = false;
    new MutationObserver(function () {
      var open = el.classList.contains('active');
      if (open === wasOpen) return;
      wasOpen = open;
      if (window.lenis) open ? window.lenis.stop() : window.lenis.start();
    }).observe(el, { attributes: true, attributeFilter: ['class'] });
  })();
</script>
