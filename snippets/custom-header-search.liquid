{% comment %}
  Inline expanding search for the custom header.

  Click the toggle -> the search field slides open in place inside the header.
  Submitting goes to the search results page. If "Enable search suggestions" is
  on in theme settings (Search), Shopify's predictive results appear below.

  Styling + open/close behaviour live in sections/custom-header.liquid
  (.inline-search CSS and the <inline-search> custom element).

  Accepts:
  - input_id: {String} unique id for the search input (required)

  Usage:
  {% render 'custom-header-search', input_id: 'CustomHeaderSearch' %}
{% endcomment %}

<inline-search class="inline-search">
  <button
    type="button"
    class="inline-search__toggle custom-header__icon-btn"
    aria-expanded="false"
    aria-controls="{{ input_id }}"
    aria-label="{{ 'general.search.search' | t }}"
  >
    <span
      class="custom-header__icon-glyph custom-header__icon-glyph--search inline-search__icon inline-search__icon--open"
      aria-hidden="true"
    ></span>
    <span class="svg-wrapper inline-search__icon inline-search__icon--close" aria-hidden="true">
      {{- 'icon-close.svg' | inline_asset_content -}}
    </span>
  </button>

  {%- if settings.predictive_search_enabled -%}
    <predictive-search class="inline-search__wrapper" data-loading-text="{{ 'accessibility.loading' | t }}">
  {%- else -%}
    <search-form class="inline-search__wrapper">
  {%- endif -%}
    <form action="{{ routes.search_url }}" method="get" role="search" class="inline-search__form">
      <div class="inline-search__field">
        <input
          class="inline-search__input"
          id="{{ input_id }}"
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'general.search.search' | t }}"
          tabindex="-1"
          {%- if settings.predictive_search_enabled -%}
            role="combobox"
            aria-expanded="false"
            aria-owns="predictive-search-results"
            aria-controls="predictive-search-results"
            aria-haspopup="listbox"
            aria-autocomplete="list"
            autocorrect="off"
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
          {%- endif -%}
        >
        <label class="visually-hidden" for="{{ input_id }}">{{ 'general.search.search' | t }}</label>
        <input type="hidden" name="options[prefix]" value="last">
        <button
          type="reset"
          class="inline-search__reset{% if search.terms == blank %} hidden{% endif %}"
          aria-label="{{ 'general.search.reset' | t }}"
        >
          <span class="svg-wrapper">{{- 'icon-reset.svg' | inline_asset_content -}}</span>
        </button>
        <button type="submit" class="inline-search__submit" aria-label="{{ 'general.search.search' | t }}">
          {%- comment -%} same glyph as the toggle, so the two magnifiers match {%- endcomment -%}
          <span class="custom-header__icon-glyph custom-header__icon-glyph--search" aria-hidden="true"></span>
        </button>
      </div>

      {%- if settings.predictive_search_enabled -%}
        <div
          class="predictive-search predictive-search--header"
          tabindex="-1"
          data-predictive-search
          id="predictive-search-results"
        >
          {%- render 'loading-spinner', class: 'predictive-search__loading-state' -%}
        </div>
        <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
      {%- endif -%}
    </form>
  {%- if settings.predictive_search_enabled -%}
    </predictive-search>
  {%- else -%}
    </search-form>
  {%- endif -%}
</inline-search>
